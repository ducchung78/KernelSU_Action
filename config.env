CONFIG_ENV=config.env

# ============================================================ Kernel source ==

KERNEL_SOURCE=https://github.com/Lutitious/android_kernel_nubia_NX729J
KERNEL_SOURCE_BRANCH=main
# Gộp trực tiếp cấu hình GKI và driver RedMagic 8 Pro qua Kbuild chuẩn
KERNEL_CONFIG=gki_defconfig vendor/kalama_GKI.config
KERNEL_IMAGE_NAME=Image.gz
ARCH=arm64

# Optional: overrides the device label used in artifact names and sets
KERNEL_NAME=NX729J-SusFS

ADD_LOCALVERSION_TO_FILENAME=false

# Khai báo tiền tố biên dịch chéo ARM64 chuẩn
EXTRA_CMDS=CROSS_COMPILE=aarch64-linux-gnu-
CUSTOM_CMDS=CLANG_TRIPLE=aarch64-linux-gnu-

# =================================================================== Clang ==
# Bộ Clang r547379 khuyến nghị chuẩn cho Kernel 5.15 GKI
CLANG_BRANCH=main-kernel-2025
CLANG_VERSION=r547379

USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

# Biên dịch hoàn toàn bằng LLVM
USE_LLVM=true

# ===================================================================== GCC ==
ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=false
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# =============================================================== KernelSU ===
# Sử dụng sukisu-ultra + builtin (Tích hợp SusFS v2.2.0 chuẩn 100%)
KSU_VARIANT=sukisu-ultra
KSU_REF=builtin

KSU_HOOK_MODE=auto

KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==
ENABLE_SUSFS=true
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ========================================================== Extra patches ===
ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ================================================================ Kconfig ===
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true

DISABLE_LTO=false
DISABLE_CC_WERROR=true

# Để trống EXTRA_DEFCONFIG vì đã gộp trực tiếp ở KERNEL_CONFIG phía trên
EXTRA_DEFCONFIG=

# ============================================================= AnyKernel3 ===
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== Packaging ===
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ================================================================ Runner ===
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
