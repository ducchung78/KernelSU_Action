CONFIG_ENV=config.env

# ============================================================ Kernel source ==

KERNEL_SOURCE=https://github.com/Lutitious/android_kernel_nubia_NX729J
KERNEL_SOURCE_BRANCH=main
KERNEL_CONFIG=gki_defconfig
KERNEL_IMAGE_NAME=Image.gz
ARCH=arm64

# Optional: overrides the device label used in artifact names and sets
KERNEL_NAME=NX729J-SusFS

ADD_LOCALVERSION_TO_FILENAME=false

# Cờ biên dịch bổ sung theo đúng cú pháp mẫu chuẩn của xiaoleGun
EXTRA_CMDS:LD=ld.lld
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# =================================================================== Clang ==
# Bộ Clang r547379 chuẩn dành cho Kernel 5.15 GKI
CLANG_BRANCH=main-kernel-2025
CLANG_VERSION=r547379

USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

# Bật LLVM hoàn toàn cho Kernel 5.15 GKI
USE_LLVM=true

# ===================================================================== GCC ==
# Bật GCC toolchain để cung cấp bộ binutils đầy đủ cho Linux Runner theo mẫu xiaoleGun
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# =============================================================== KernelSU ===
# Sử dụng sukisu-ultra + builtin (Tích hợp SusFS v2.2.0 chuẩn 100%)
KSU_VARIANT=sukisu-ultra
KSU_REF=builtin

KSU_HOOK_MODE=auto

KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==
ENABLE_SUSFS=true
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ========================================================== Extra patches ===
ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ================================================================ Kconfig ===
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true

DISABLE_LTO=true
DISABLE_CC_WERROR=true

# Trộn cấu hình driver Qualcomm Kalama của RedMagic 8 Pro
EXTRA_DEFCONFIG=vendor/kalama_GKI.config

# ============================================================= AnyKernel3 ===
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== Packaging ===
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ================================================================ Runner ===
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
