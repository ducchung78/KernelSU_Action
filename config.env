CONFIG_ENV=config.env

# ============================================================ Kernel source ==

KERNEL_SOURCE=https://github.com/Lutitious/android_kernel_nubia_NX729J
KERNEL_SOURCE_BRANCH=main
KERNEL_CONFIG=gki_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64

# Optional: overrides the device label used in artifact names and sets
# CONFIG_LOCALVERSION. Leave blank to derive it from KERNEL_CONFIG.
KERNEL_NAME=NX729J-SusFS

ADD_LOCALVERSION_TO_FILENAME=false

# Extra flags appended to every make invocation. Values may contain "=".
EXTRA_CMDS:LD=ld.lld
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# =================================================================== Clang ==
# Cấu hình bộ biên dịch Clang r596125 mới nhất hỗ trợ Kernel 5.15+
CLANG_BRANCH=main-kernel
CLANG_VERSION=r596125

USE_CUSTOM_ClANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=

# Biên dịch hoàn toàn bằng LLVM (Khuyên dùng cho Kernel 5.10+)
USE_LLVM=true

# ===================================================================== GCC ==
# Tắt GCC vì đã dùng LLVM=1 biên dịch toàn bộ cho nhân 5.15+
ENABLE_GCC_ARM64=false
ENABLE_GCC_ARM32=false
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# =============================================================== KernelSU ===
# Chọn tích hợp bản KernelSU-Next (KSU Next) bản ổn định
KSU_VARIANT=sukisu-ultra
KSU_REF=builtin

KSU_HOOK_MODE=auto

KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==
# Bật tính năng ẩn root của SusFS v2.2.0
ENABLE_SUSFS=true
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ========================================================== Extra patches ===
ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ================================================================ Kconfig ===
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=false

EXTRA_DEFCONFIG=

# ============================================================= AnyKernel3 ===
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== Packaging ===
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ================================================================ Runner ===
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
